<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetHog.Avalonia.DomainDialog"
        Title="Domains"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
    <StackPanel Spacing="3">
      <TextBlock Text="Domains" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Visible DNS, TLS SNI, and HTTP Host metadata. HTTPS is not decrypted." Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Classes="panel" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Observations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                <Grid ColumnDefinitions="1.5*,*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Domain}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceText}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding LastSeenText}" />
                    <TextBlock Text="{Binding SeenText}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="primary" Content="Close" Click="Close_Click" />
    </Grid>
  </Grid>
</Window>
