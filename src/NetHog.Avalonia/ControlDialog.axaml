<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetHog.Avalonia.ControlDialog"
        Title="Set controls"
        Width="430"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource SurfaceBrush}" Padding="24">
    <StackPanel Spacing="14">
      <StackPanel Spacing="3">
        <TextBlock Text="Temporary device control" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding TargetDescription}" Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Preset" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" SelectionChanged="Preset_SelectionChanged" />
        <TextBlock Text="{Binding PresetDescription}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Download limit" FontWeight="SemiBold" />
          <TextBox Text="{Binding DownloadText, Mode=TwoWay}" Watermark="Unlimited" />
          <TextBlock Text="Mbps; blank keeps it unlimited" Classes="muted" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Upload limit" FontWeight="SemiBold" />
          <TextBox Text="{Binding UploadText, Mode=TwoWay}" Watermark="Unlimited" />
          <TextBlock Text="Mbps; blank keeps it unlimited" Classes="muted" FontSize="11" />
        </StackPanel>
      </Grid>

      <CheckBox Content="Block routed IPv4 internet traffic" IsChecked="{Binding BlockInternet, Mode=TwoWay}" />
      <TextBlock Text="Controls are temporary and may not affect same-LAN, IPv6, VPN, or isolated traffic." Classes="muted" FontSize="11" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0" ColumnSpacing="10">
        <TextBlock Text="{Binding ValidationText}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="quiet" Content="Cancel" Click="Cancel_Click" />
        <Button Grid.Column="2" Classes="primary" Content="Apply control" Click="Save_Click" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
