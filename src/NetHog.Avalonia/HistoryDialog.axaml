<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetHog.Avalonia.HistoryDialog"
        Title="Session history"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
    <StackPanel Spacing="3">
      <TextBlock Text="Session history" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Completed control sessions stored on this computer." Classes="muted" />
    </StackPanel>
    <Border Grid.Row="1" Classes="panel" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Records}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                <Grid ColumnDefinitions="1.2*,*,*,1.5*" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding StartedText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding InterfaceText}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding DurationText}" />
                    <TextBlock Text="{Binding DeviceCountText}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding DownloadText}" />
                    <TextBlock Text="{Binding UploadText}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding ControlSummary}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="quiet" Content="Delete all" Click="DeleteAll_Click" />
      <Button Grid.Column="2" Classes="primary" Content="Close" Click="Close_Click" />
    </Grid>
  </Grid>
</Window>
