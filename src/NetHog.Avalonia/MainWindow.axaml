<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetHog.Avalonia.MainWindow"
        Title="NetHog"
        Width="1320"
        Height="820"
        MinWidth="900"
        MinHeight="640">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="18,24,18,18">
        <StackPanel Spacing="4">
          <TextBlock Text="NetHog" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
          <TextBlock Text="CROSS-PLATFORM NETWORK CONTROL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" LetterSpacing="1" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,34,0,0" Spacing="5">
          <Button Classes="nav" Content="Devices" Click="DevicesNav_Click" />
          <Button Classes="nav" Content="Settings" Click="SettingsNav_Click" />
          <Button Classes="nav" Content="Session history" Click="HistoryNav_Click" />
          <Button Classes="nav" Content="Domains" Click="DomainsNav_Click" />
          <Button Classes="nav" Content="Live chart" Click="ChartNav_Click" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4">
          <TextBlock Text="AVALONIA BETA" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="Windows + Linux" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="Controls require elevated permission and a packet-capture library." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32,28,32,24" Spacing="18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="page-title" Text="Network devices" />
            <TextBlock Classes="muted" Text="See devices on the Ethernet or Wi-Fi network used by this computer." Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="Scan network" Click="ScanButton_Click" MinWidth="132" />
        </Grid>

        <Grid ColumnDefinitions="Auto,260,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="6">
          <TextBlock Text="ADAPTER" Classes="section-label" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" SelectionChanged="AdapterComboBox_SelectionChanged" PlaceholderText="No IPv4 adapter found" />
          <TextBlock Grid.Column="2" Text="{Binding AdapterDiagnosticsText}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" />
        </Grid>

        <Border Classes="panel" Padding="16,12">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
            <CheckBox Content="I administer this network and authorize temporary IPv4 controls for selected devices."
                      IsChecked="{Binding IsNetworkAdminConfirmed, Mode=TwoWay}"
                      VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="quiet" Content="Apply to selected" Click="ApplySelected_Click" />
            <Button Grid.Column="2" Classes="quiet" Content="Restore network" Click="RestoreButton_Click" />
            <Button Grid.Column="3" Classes="primary" Content="{Binding SessionButtonText}" Click="ControlSessionButton_Click" />
            <TextBlock Grid.Row="1" Text="{Binding AvailabilityText}" Classes="muted" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border Classes="notice" Padding="16,12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="IPv4 controls · dual-stack traffic" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Text="Live rates are based on observed traffic. Controls affect IPv4 traffic routed through this gateway; IPv6 may bypass them." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
          <StackPanel>
            <TextBlock Text="DEVICES VISIBLE" Classes="section-label" />
            <TextBlock Text="{Binding DeviceCountText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="LIVE TRAFFIC RATE" Classes="section-label" />
            <TextBlock Text="{Binding TrafficSummaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="CONTROL ENGINE" Classes="section-label" />
            <TextBlock Text="{Binding EngineStatusText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="3" HorizontalAlignment="Right">
            <TextBlock Text="CURRENT NETWORK" Classes="section-label" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding CurrentNetworkText}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="Select devices below to apply one temporary rule to several devices." Classes="muted" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="quiet" Content="Select all eligible" Click="SelectAllButton_Click" Margin="8,0,0,0" />
          <Button Grid.Column="2" Classes="quiet" Content="Clear selection" Click="ClearSelectionButton_Click" Margin="8,0,0,0" />
        </Grid>

        <Border Classes="panel" Padding="0">
          <Grid RowDefinitions="44,*">
            <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0">
              <Grid ColumnDefinitions="42,1.05*,1.15*,1.1*,1.25*,Auto" ColumnSpacing="10">
                <TextBlock Text="SELECT" Classes="section-label" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="DEVICE / IP" Classes="section-label" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="MAC ADDRESS" Classes="section-label" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="TRAFFIC" Classes="section-label" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="CONTROL" Classes="section-label" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="ACTION" Classes="section-label" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" MaxHeight="420" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                      <Grid ColumnDefinitions="42,1.05*,1.15*,1.1*,1.25*,Auto" ColumnSpacing="10" MinHeight="62">
                        <CheckBox IsChecked="{Binding IsBulkSelected, Mode=TwoWay}" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding AddressSummary}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding MacAddress}" FontSize="12" />
                          <TextBlock Text="{Binding ProximitySummary}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding TrafficSummary}" FontSize="12" />
                          <TextBlock Text="{Binding SessionTrafficSummary}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding ControlSummary}" Foreground="{DynamicResource GoodBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding ControlBlockedText}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" Spacing="4" VerticalAlignment="Center">
                          <Button Classes="quiet" Content="Set controls" Click="SetControls_Click" />
                          <Button Classes="quiet" Content="Remove my control" Click="RemoveMyControl_Click" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
