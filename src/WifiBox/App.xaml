<Application x:Class="WifiBox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="CanvasColor">#F4F6F8</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="SidebarColor">#F8F9FA</Color>
        <Color x:Key="InkColor">#18212B</Color>
        <Color x:Key="MutedColor">#626D7A</Color>
        <Color x:Key="LineColor">#E2E7EC</Color>
        <Color x:Key="AccentColor">#126B5A</Color>
        <Color x:Key="AccentSoftColor">#E7F3EF</Color>
        <Color x:Key="GoodColor">#16745F</Color>
        <Color x:Key="GoodSoftColor">#E9F4F0</Color>
        <Color x:Key="WarningColor">#946200</Color>
        <Color x:Key="WarningSoftColor">#FFF4D6</Color>
        <Color x:Key="DangerColor">#B33D43</Color>
        <Color x:Key="DangerSoftColor">#FBECEE</Color>

        <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
        <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
        <SolidColorBrush x:Key="GoodSoftBrush" Color="{StaticResource GoodSoftColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Application.Resources>
</Application>
