<Window x:Class="WifiBox.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session history" Width="980" Height="650" MinWidth="760" MinHeight="520"
        Icon="pack://application:,,,/Assets/NetHog.ico"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="AlternatingRowBackground" Value="#FBFCFC" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Session history" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Review cumulative traffic and controls from completed sessions on this PC."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.85*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Margin="0,0,12,0">
                <DataGrid x:Name="SessionsGrid" SelectionChanged="SessionsGrid_SelectionChanged"
                          AutomationProperties.Name="Completed control sessions">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STARTED" Binding="{Binding StartedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="1.2*" />
                        <DataGridTextColumn Header="DEVICES" Binding="{Binding Devices.Count}" Width="0.65*" />
                        <DataGridTextColumn Header="DURATION" Binding="{Binding Duration, StringFormat={}{0:hh\\:mm\\:ss}}" Width="0.9*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitleText" Text="Select a session" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailSubtitleText" Text="Completed session details appear here." FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TOTAL DOWNLOAD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="DownloadTotalText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTAL UPLOAD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="UploadTotalText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="2" x:Name="DevicesGrid" AutomationProperties.Name="Traffic totals by device">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DEVICE" Binding="{Binding DisplayName}" Width="1.2*" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="1*" />
                            <DataGridTextColumn Header="DOWNLOAD" Binding="{Binding Download}" Width="1*" />
                            <DataGridTextColumn Header="UPLOAD" Binding="{Binding Upload}" Width="1*" />
                            <DataGridTextColumn Header="CONTROL" Binding="{Binding ControlSummary}" Width="1.15*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="History is stored as app data, not cache. Uninstalling NetHog removes it."
                   FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="1,14,0,0" />
    </Grid>
</Window>
