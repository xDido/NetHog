<Window x:Class="WifiBox.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520"
        SizeToContent="Height"
        MinWidth="440"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Margin="20" Padding="24" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Choose how NetHog behaves when Windows starts and when you close the window."
                           FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="Traffic display" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Choose the units used for live rates and captured totals." FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Live rate units" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="RateUnitComboBox" Grid.Column="1" SelectedIndex="0" Padding="8,5">
                        <ComboBoxItem Content="Bits per second (Mbps)" />
                        <ComboBoxItem Content="Bytes per second (MB/s)" />
                    </ComboBox>
                </Grid>
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total size units" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="DataUnitComboBox" Grid.Column="1" SelectedIndex="0" Padding="8,5">
                        <ComboBoxItem Content="Decimal (MB, GB)" />
                        <ComboBoxItem Content="Binary (MiB, GiB)" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,22,0,0">
                <CheckBox x:Name="StartWithWindowsCheckBox" FontSize="13" FontWeight="SemiBold"
                          Content="Start NetHog with Windows" />
                <TextBlock Text="NetHog will launch in the background using the Windows per-user startup list."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="24,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <CheckBox x:Name="MinimizeToTrayCheckBox" FontSize="13" FontWeight="SemiBold"
                          Content="Minimize to the notification area when closing" />
                <TextBlock Text="The window hides instead of exiting. Use the NetHog tray menu to show it or exit."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="24,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <CheckBox x:Name="AutomaticUpdatesCheckBox" FontSize="13" FontWeight="SemiBold"
                          Content="Check for updates automatically" />
                <TextBlock Text="Checks release metadata when NetHog starts. It never downloads files in the background."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="24,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                <Button Content="Cancel" Click="CancelButton_Click" Padding="16,9" Margin="0,0,8,0" />
                <Button Content="Save settings" Click="SaveButton_Click"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}" Padding="16,9" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
