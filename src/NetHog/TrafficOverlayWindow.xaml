<Window x:Class="NetHog.TrafficOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetHog traffic overlay"
        Width="190" Height="52"
        Icon="pack://application:,,,/Assets/NetHog.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource OverlayGlassBrush}"
            BorderBrush="{DynamicResource OverlayGlassLineBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="8,5"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="4"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel ToolTip="Download: traffic received by this PC from the network.">
                <TextBlock Text="↓ DOWNLOAD" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource DownloadBrush}" />
                <TextBlock x:Name="DownloadRateText" Text="—" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource DownloadBrush}" Margin="0,1,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Width="1" Height="22" Background="{DynamicResource LineBrush}"
                    VerticalAlignment="Center" Margin="7,0" />
            <StackPanel Grid.Column="2" ToolTip="Upload: traffic sent by this PC to the network.">
                <TextBlock Text="↑ UPLOAD" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource UploadBrush}" />
                <TextBlock x:Name="UploadRateText" Text="—" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource UploadBrush}" Margin="0,1,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
