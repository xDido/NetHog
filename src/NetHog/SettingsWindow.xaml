<Window x:Class="NetHog.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="820"
        SizeToContent="Height"
        MinWidth="760"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Margin="20" Padding="24" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Choose how NetHog behaves when Windows starts and when you close the window."
                           FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                        Background="{DynamicResource LineBrush}" />

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Traffic display" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Choose the units used for live rates and captured totals." FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Live rate units" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="RateUnitComboBox" Grid.Column="1" SelectedIndex="0" Padding="8,5">
                            <ComboBoxItem Content="Bits per second (Mbps)" />
                            <ComboBoxItem Content="Bytes per second (MB/s)" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total size units" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="DataUnitComboBox" Grid.Column="1" SelectedIndex="0" Padding="8,5">
                            <ComboBoxItem Content="Decimal (MB, GB)" />
                            <ComboBoxItem Content="Binary (MiB, GiB)" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Overlay" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,0" />
                    <CheckBox x:Name="TrafficOverlayCheckBox" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="Show current PC traffic overlay" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Keep a small always-on-top widget visible with this PC's current download and upload rate."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <Grid Margin="24,10,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=TrafficOverlayCheckBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overlay position" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="OverlayPositionComboBox" Grid.Column="1" Padding="8,5">
                            <ComboBoxItem Content="Top-left" />
                            <ComboBoxItem Content="Top-center" />
                            <ComboBoxItem Content="Top-right" />
                            <ComboBoxItem Content="Middle-left" />
                            <ComboBoxItem Content="Middle-right" />
                            <ComboBoxItem Content="Bottom-left" />
                            <ComboBoxItem Content="Bottom-center" />
                            <ComboBoxItem Content="Bottom-right" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="24,9,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=TrafficOverlayCheckBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overlay opacity" VerticalAlignment="Center" FontSize="13" />
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OverlayOpacitySlider" MinWidth="100" HorizontalAlignment="Stretch"
                                    Minimum="35" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="OverlayOpacitySlider_ValueChanged" />
                            <TextBlock x:Name="OverlayOpacityText" Grid.Column="1" MinWidth="45"
                                       TextAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Grid>
                    <Grid Margin="24,9,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=TrafficOverlayCheckBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overlay display" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="OverlayScreenComboBox" Grid.Column="1" Padding="8,5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding DeviceName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="OverlayClickThroughCheckBox" Margin="24,9,0,0"
                              IsEnabled="{Binding IsChecked, ElementName=TrafficOverlayCheckBox}">
                        <StackPanel>
                            <TextBlock Text="Click-through overlay" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="The widget will not intercept mouse clicks. Turn this off temporarily if you want to drag it."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Traffic alerts" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,0" />
                    <CheckBox x:Name="TrafficAlertsCheckBox" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="Alert on high device traffic" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Show a notification when one device exceeds the combined download and upload threshold."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <Grid Margin="24,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alert threshold" VerticalAlignment="Center" FontSize="13" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TrafficAlertThresholdTextBox" Height="34" Padding="8,5"
                                     HorizontalContentAlignment="Center" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Margin="0,0,6,0" />
                            <Border Grid.Column="1" Height="34" Background="{DynamicResource InputUnitSurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Mbps" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Appearance and behavior" FontSize="13" FontWeight="SemiBold" />
                    <CheckBox x:Name="DarkModeCheckBox" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="Use dark mode" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Use a darker palette for lower-glare network monitoring, including dialogs and charts."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Start NetHog with Windows" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="NetHog will launch in the background using the Windows per-user startup list."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="MinimizeToTrayCheckBox" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Minimize to the notification area when closing" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="The window hides instead of exiting. Use the NetHog tray menu to show it or exit."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutomaticUpdatesCheckBox" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Check for updates automatically" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Checks release metadata when NetHog starts. It never downloads files in the background."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Session history" FontSize="13" FontWeight="SemiBold" Margin="0,24,0,0" />
                    <TextBlock Text="Choose whether completed sessions are removed automatically as they age."
                               FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <CheckBox x:Name="HistoryRetentionCheckBox" Content="Automatically remove old sessions"
                              FontSize="13" FontWeight="SemiBold" Checked="HistoryRetentionCheckBox_Changed"
                              Unchecked="HistoryRetentionCheckBox_Changed" />
                    <Grid x:Name="HistoryRetentionControls" Margin="24,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Keep completed sessions for" VerticalAlignment="Center" FontSize="12"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="HistoryRetentionValueTextBox" Grid.Column="1"
                                 Padding="8,5" HorizontalContentAlignment="Center"
                                 TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="HistoryRetentionUnitComboBox" Grid.Column="2" Padding="8,5">
                            <ComboBoxItem Content="hours" />
                            <ComboBoxItem Content="days" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="Older sessions are removed when NetHog starts, saves a session, or opens history."
                               FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="24,6,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Click="CancelButton_Click" Padding="16,9" Margin="0,0,8,0" />
                <Button Click="SaveButton_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF"
                        BorderBrush="{DynamicResource AccentBrush}" Padding="16,9" FontWeight="SemiBold">
                    <TextBlock Text="Save settings"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
