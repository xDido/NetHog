<Window x:Class="NetHog.TrafficChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live traffic chart" Width="900" Height="560" MinWidth="700" MinHeight="440"
        Icon="pack://application:,,,/Assets/NetHog.ico"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Live traffic" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="A rolling fifteen-minute view of observed traffic. NetHog keeps this timeline in memory only."
                       FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DEVICE" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <ComboBox x:Name="DeviceComboBox" Grid.Column="1" Margin="10,0,0,0"
                      SelectionChanged="DeviceComboBox_SelectionChanged"
                      AutomationProperties.Name="Chart device selection">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AddressSummary}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            ToolTip="Download: traffic received by the selected device from the network."
                            AutomationProperties.Name="Download traffic legend">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource DownloadBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="download" FontSize="12" Foreground="{DynamicResource DownloadBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                            ToolTip="Upload: traffic sent by the selected device to the network."
                            AutomationProperties.Name="Upload traffic legend">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource UploadBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="upload" FontSize="12" Foreground="{DynamicResource UploadBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9"
                Padding="18,18,18,14">
            <Grid AutomationProperties.Name="Traffic chart with time and rate axes">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock x:Name="ChartMaxRateText" Text="—" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Top value on the rate axis." />
                    <TextBlock x:Name="ChartMidRateText" Text="—" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Midpoint value on the rate axis." />
                    <TextBlock x:Name="ChartMinRateText" Text="0 Kbps" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Zero value on the rate axis." />
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1">
                    <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged" />
                    <StackPanel x:Name="EmptyChartState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="No traffic samples yet" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Start a control session and choose a device to see the live timeline."
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="RATE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"
                           HorizontalAlignment="Right" Margin="0,8,10,0" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,7,0,0">
                    <TextBlock x:Name="ChartStartTimeText" Text="—" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ChartMidTimeText" Text="—" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ChartEndTimeText" Text="—" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="1,13,0,0">
            <TextBlock x:Name="ChartContextText" Text="Session not active"
                       FontSize="12" Foreground="{DynamicResource MutedBrush}" />
            <StackPanel x:Name="ChartMetricPanel" Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="ChartDownloadSummaryText" Foreground="{DynamicResource DownloadBrush}"
                           FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="·" Foreground="{DynamicResource MutedBrush}" Margin="8,0" />
                <TextBlock x:Name="ChartUploadSummaryText" Foreground="{DynamicResource UploadBrush}"
                           FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
