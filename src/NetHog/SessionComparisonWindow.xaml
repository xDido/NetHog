<Window x:Class="NetHog.SessionComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare sessions" Width="760" Height="430" MinWidth="620" MinHeight="360"
        Icon="pack://application:,,,/Assets/NetHog.ico"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Compare sessions" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="A compact comparison of the two selected completed sessions."
                       FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="FirstDateText" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="FirstNetworkText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,4,0,18" TextWrapping="Wrap" />
                    <StackPanel>
                        <TextBlock x:Name="FirstDurationText" FontSize="13" />
                        <TextBlock x:Name="FirstDevicesText" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock x:Name="FirstDownloadText" FontSize="13" Foreground="{DynamicResource DownloadBrush}" Margin="0,4,0,0"
                                   ToolTip="Download: total traffic received during this session." />
                        <TextBlock x:Name="FirstUploadText" FontSize="13" Foreground="{DynamicResource UploadBrush}" Margin="0,4,0,0"
                                   ToolTip="Upload: total traffic sent during this session." />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="SecondDateText" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="SecondNetworkText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,4,0,18" TextWrapping="Wrap" />
                    <StackPanel>
                        <TextBlock x:Name="SecondDurationText" FontSize="13" />
                        <TextBlock x:Name="SecondDevicesText" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock x:Name="SecondDownloadText" FontSize="13" Foreground="{DynamicResource DownloadBrush}" Margin="0,4,0,0"
                                   ToolTip="Download: total traffic received during this session." />
                        <TextBlock x:Name="SecondUploadText" FontSize="13" Foreground="{DynamicResource UploadBrush}" Margin="0,4,0,0"
                                   ToolTip="Upload: total traffic sent during this session." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="Traffic totals are observed IPv4/IPv6 bytes attributed to visible devices during each session."
                   FontSize="12" Foreground="{DynamicResource MutedBrush}" />
    </Grid>
</Window>
